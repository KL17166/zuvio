<%- include('../partials/header') %>

    <div class="container d-flex flex-column justify-content-center align-items-center vh-100">
        <div class="text-center">
            <div class="display-1 text-danger fw-bold">500</div>
            <h2 class="mb-4">Oops! Algo deu errado.</h2>
            <p class="lead text-muted mb-5">
                <%= message || 'Erro interno do servidor' %>
            </p>

            <% if (error && error.stack) { %>
                <div class="card text-start mb-5 w-100" style="max-width: 800px; max-height: 400px; overflow: auto;">
                    <div class="card-body bg-light">
                        <h5 class="card-title text-danger">Detalhes do Erro (Ambiente de Desenvolvimento)</h5>
                        <pre><code><%= error.stack %></code></pre>
                    </div>
                </div>
                <% } %>

                    <a href="/admin/dashboard" class="btn btn-primary btn-lg">
                        <i class="bi bi-house-door me-2"></i> Voltar para o Dashboard
                    </a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>

    </html>