<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/kyc' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">🔍 Verificação KYC</h1>
                    <p class="text-muted mb-0">Verificação de identidade dos clientes</p>
                </div>
                <div class="top-bar-actions">
                    <% if (user) { %>
                        <div class="user-info">
                            <div class="user-avatar">
                                <%= user.name.charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <div style="font-weight: 600; font-size: 0.9rem;">
                                    <%= user.name %>
                                </div>
                                <div style="font-size: 0.75rem; color: var(--text-secondary);">Administrador</div>
                            </div>
                        </div>
                    <% } %>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>
                    <%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>
                    <%= successMessage %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <%= errorMessage %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Stats Cards -->
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Pendentes</div>
                                <div style="font-size: 1.8rem; font-weight: 800; line-height: 1; color: #f59e0b;">
                                    <%= pendingUsers.length %>
                                </div>
                                <small class="text-muted mt-2 d-block">Aguardando revisão</small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                                <i class="bi bi-hourglass-split"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Aprovados</div>
                                <div style="font-size: 1.8rem; font-weight: 800; line-height: 1; color: #10b981;">
                                    <%= (recentlyReviewed || []).filter(u => u.kycStatus === 'APPROVED').length %>
                                </div>
                                <small class="text-muted mt-2 d-block">Recentemente</small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                <i class="bi bi-person-check"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="premium-stat-card p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="info-label">Rejeitados</div>
                                <div style="font-size: 1.8rem; font-weight: 800; line-height: 1; color: #ef4444;">
                                    <%= (recentlyReviewed || []).filter(u => u.kycStatus === 'REJECTED').length %>
                                </div>
                                <small class="text-muted mt-2 d-block">Recentemente</small>
                            </div>
                            <div class="stat-icon-wrapper" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                                <i class="bi bi-person-x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pending KYC Reviews -->
            <div class="row g-4 mb-4">
                <div class="col-12">
                    <div class="premium-table-container">
                        <div class="p-4 border-bottom" style="border-color: var(--border-color) !important;">
                            <h5 class="mb-0">
                                <i class="bi bi-clock-history me-2" style="color: var(--warning-color);"></i>
                                Verificações Pendentes
                            </h5>
                        </div>
                        <% if (pendingUsers.length === 0) { %>
                            <div class="text-center py-5">
                                <i class="bi bi-check-circle" style="font-size: 4rem; color: var(--success-color);"></i>
                                <h4 class="mt-3">Nenhuma verificação pendente</h4>
                                <p class="text-muted">Todos os clientes foram verificados.</p>
                            </div>
                        <% } else { %>
                            <% pendingUsers.forEach(pUser => { %>
                                <div class="p-4 border-bottom" style="border-color: var(--border-color) !important;">
                                    <!-- User Header -->
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1.2rem;">
                                                <%= pUser.name.charAt(0).toUpperCase() %>
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold"><%= pUser.name %></h6>
                                                <small class="text-muted">CPF: <%= pUser.cpf %> | Email: <%= pUser.email %> | Tel: <%= pUser.phone || 'N/A' %></small>
                                            </div>
                                        </div>
                                        <span class="badge-premium" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                                            <i class="bi bi-clock"></i> <%= pUser.kycStatus %>
                                        </span>
                                    </div>

                                    <!-- Documents -->
                                    <h6 class="mb-3"><i class="bi bi-file-earmark-image me-1"></i> Documentos enviados</h6>
                                    <div class="row mb-4">
                                        <div class="col-md-4 text-center">
                                            <p class="fw-bold mb-1" style="font-size: 0.85rem;">Documento (Frente)</p>
                                            <% if (pUser.documentFrontUrl) { %>
                                                <img src="<%= pUser.documentFrontUrl %>" class="img-fluid rounded" style="max-height: 200px; cursor: pointer; border: 2px solid var(--border-color); border-radius: 12px !important;" onclick="window.open(this.src, '_blank')" alt="Doc Frente">
                                            <% } else { %>
                                                <div style="border: 2px dashed var(--border-color); border-radius: 12px; padding: 2rem;" class="text-muted">
                                                    <i class="bi bi-x-circle" style="font-size: 1.5rem;"></i>
                                                    <p class="mb-0 mt-1" style="font-size: 0.85rem;">Não enviado</p>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="col-md-4 text-center">
                                            <p class="fw-bold mb-1" style="font-size: 0.85rem;">Documento (Verso)</p>
                                            <% if (pUser.documentBackUrl) { %>
                                                <img src="<%= pUser.documentBackUrl %>" class="img-fluid rounded" style="max-height: 200px; cursor: pointer; border: 2px solid var(--border-color); border-radius: 12px !important;" onclick="window.open(this.src, '_blank')" alt="Doc Verso">
                                            <% } else { %>
                                                <div style="border: 2px dashed var(--border-color); border-radius: 12px; padding: 2rem;" class="text-muted">
                                                    <i class="bi bi-x-circle" style="font-size: 1.5rem;"></i>
                                                    <p class="mb-0 mt-1" style="font-size: 0.85rem;">Não enviado</p>
                                                </div>
                                            <% } %>
                                        </div>
                                        <div class="col-md-4 text-center">
                                            <p class="fw-bold mb-1" style="font-size: 0.85rem;">Selfie</p>
                                            <% if (pUser.selfieUrl) { %>
                                                <img src="<%= pUser.selfieUrl %>" class="img-fluid rounded" style="max-height: 200px; cursor: pointer; border: 2px solid var(--border-color); border-radius: 12px !important;" onclick="window.open(this.src, '_blank')" alt="Selfie">
                                            <% } else { %>
                                                <div style="border: 2px dashed var(--border-color); border-radius: 12px; padding: 2rem;" class="text-muted">
                                                    <i class="bi bi-x-circle" style="font-size: 1.5rem;"></i>
                                                    <p class="mb-0 mt-1" style="font-size: 0.85rem;">Não enviado</p>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>

                                    <!-- Subscriptions -->
                                    <% if (pUser.subscriptions && pUser.subscriptions.length > 0) { %>
                                        <h6 class="mb-2"><i class="bi bi-file-text me-1"></i> Contratos pendentes</h6>
                                        <div class="table-responsive mb-3">
                                            <table class="table table-custom table-sm">
                                                <thead>
                                                    <tr>
                                                        <th>Produto</th>
                                                        <th>Plano</th>
                                                        <th>Valor</th>
                                                        <th>Adesão</th>
                                                        <th>Status</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% pUser.subscriptions.forEach(sub => { %>
                                                        <tr>
                                                            <td><%= sub.plan.product.name %></td>
                                                            <td><%= sub.plan.name %></td>
                                                            <td>R$ <%= Number(sub.creditValue).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></td>
                                                            <td>
                                                                <% if (sub.installments[0] && sub.installments[0].status === 'PAID') { %>
                                                                    <span class="badge-premium" style="background: rgba(16, 185, 129, 0.1); color: #10b981;"><i class="bi bi-check-circle"></i> Paga</span>
                                                                <% } else { %>
                                                                    <span class="badge-premium" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;"><i class="bi bi-clock"></i> Pendente</span>
                                                                <% } %>
                                                            </td>
                                                            <td><span class="badge-premium" style="background: rgba(59, 130, 246, 0.1); color: #3b82f6;"><%= sub.status %></span></td>
                                                        </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } %>

                                    <!-- Actions -->
                                    <div class="d-flex gap-2 mt-3">
                                        <form action="/admin/kyc/<%= pUser.id %>/approve" method="POST" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="btn btn-success" onclick="return confirm('Aprovar KYC de <%= pUser.name %>? Os contratos serão ativados.')">
                                                <i class="bi bi-check-lg me-1"></i> Aprovar
                                            </button>
                                        </form>
                                        <form action="/admin/kyc/<%= pUser.id %>/reject" method="POST" class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <div class="input-group">
                                                <input type="text" name="reason" class="form-control" placeholder="Motivo da rejeição..." style="min-width: 250px;">
                                                <button type="submit" class="btn btn-danger" onclick="return confirm('Rejeitar KYC de <%= pUser.name %>? Os contratos serão cancelados e parcelas reembolsadas.')">
                                                    <i class="bi bi-x-lg me-1"></i> Rejeitar
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            <% }); %>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Recently Reviewed -->
            <% if (recentlyReviewed && recentlyReviewed.length > 0) { %>
                <div class="row g-4">
                    <div class="col-12">
                        <div class="premium-table-container">
                            <div class="p-4 border-bottom" style="border-color: var(--border-color) !important;">
                                <h5 class="mb-0">
                                    <i class="bi bi-check2-all me-2" style="color: var(--success-color);"></i>
                                    Revisados Recentemente
                                </h5>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-custom">
                                    <thead>
                                        <tr>
                                            <th>Cliente</th>
                                            <th>CPF</th>
                                            <th>Status</th>
                                            <th>Revisado em</th>
                                            <th>Motivo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% recentlyReviewed.forEach(rUser => { %>
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div style="width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 0.8rem;">
                                                            <%= rUser.name.charAt(0).toUpperCase() %>
                                                        </div>
                                                        <span class="fw-medium"><%= rUser.name %></span>
                                                    </div>
                                                </td>
                                                <td><code><%= rUser.cpf %></code></td>
                                                <td>
                                                    <% if (rUser.kycStatus === 'APPROVED') { %>
                                                        <span class="badge-premium" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                                                            <i class="bi bi-check-circle"></i> Aprovado
                                                        </span>
                                                    <% } else { %>
                                                        <span class="badge-premium" style="background: rgba(239, 68, 68, 0.1); color: #ef4444;">
                                                            <i class="bi bi-x-circle"></i> Rejeitado
                                                        </span>
                                                    <% } %>
                                                </td>
                                                <td><%= rUser.kycReviewedAt ? new Date(rUser.kycReviewedAt).toLocaleDateString('pt-BR') : '-' %></td>
                                                <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis;"><%= rUser.kycRejectReason || '-' %></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>

<%- include('../../partials/footer') %>
