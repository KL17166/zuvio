<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/users' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">
                        <%= editing ? 'Editar Usuário' : 'Novo Usuário' %>
                    </h1>
                    <p class="text-muted mb-0">
                        <%= editing ? editUser.name : 'Preencha os dados para criar um novo usuário' %>
                    </p>
                </div>
                <div class="top-bar-actions">
                    <a href="/admin/users" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Voltar
                    </a>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof error_msg !=='undefined' && error_msg && error_msg.length> 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <%= error_msg %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                    <form action="/admin/users/<%= editing ? editUser.id + '/edit' : 'new' %>" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <div class="row g-4">
                            <div class="col-md-8">
                                <div class="card shadow-sm border-0 mb-4 h-100">
                                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center">
                                        <i class="bi bi-person text-primary fs-5 me-2"></i>
                                        <h5 class="mb-0 fw-bold">Dados Pessoais</h5>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Nome Completo *</label>
                                                <input type="text" name="name" class="form-control" value="<%= editUser.name || '' %>"
                                                    required placeholder="Digite o nome completo">
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Email *</label>
                                                <input type="email" name="email" class="form-control"
                                                    value="<%= editUser.email || '' %>" required placeholder="exemplo@email.com">
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label fw-bold">CPF *</label>
                                                <input type="text" name="cpf" class="form-control" value="<%= editUser.cpf || '' %>"
                                                    required placeholder="00000000000" maxlength="11" <%=editing ? 'disabled' : ''
                                                    %>>
                                                <% if (editing) { %>
                                                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Apenas leitura</small>
                                                <% } %>
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label fw-bold">Nascimento *</label>
                                                <input type="date" name="birthDate" class="form-control"
                                                    value="<%= editUser.birthDate ? new Date(editUser.birthDate).toISOString().split('T')[0] : '' %>"
                                                    required>
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label fw-bold">Telefone</label>
                                                <input type="text" name="phone" class="form-control" value="<%= editUser.phone || '' %>"
                                                    placeholder="(00) 00000-0000">
                                            </div>
                                            
                                            <div class="col-12 mt-4">
                                                <hr class="text-muted opacity-25 my-0">
                                            </div>
                                            
                                            <div class="col-12 mt-4">
                                                <h6 class="fw-bold mb-3 d-flex align-items-center">
                                                    <i class="bi bi-geo-alt text-secondary me-2"></i>Endereço
                                                </h6>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label fw-bold">CEP</label>
                                                <input type="text" name="address_cep" class="form-control" value="<%= parsedAddress.cep || '' %>"
                                                    placeholder="00000-000">
                                            </div>

                                            <div class="col-md-7">
                                                <label class="form-label fw-bold">Rua/Logradouro</label>
                                                <input type="text" name="address_street" class="form-control" value="<%= parsedAddress.street || '' %>"
                                                    placeholder="Nome da rua">
                                            </div>

                                            <div class="col-md-2">
                                                <label class="form-label fw-bold">Número</label>
                                                <input type="text" name="address_number" class="form-control" value="<%= parsedAddress.number || '' %>"
                                                    placeholder="S/N">
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label fw-bold">Complemento</label>
                                                <input type="text" name="address_complement" class="form-control" value="<%= parsedAddress.complement || '' %>"
                                                    placeholder="Apto, Bloco, etc">
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label fw-bold">Bairro</label>
                                                <input type="text" name="address_neighborhood" class="form-control" value="<%= parsedAddress.neighborhood || '' %>"
                                                    placeholder="Bairro">
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label fw-bold">Cidade</label>
                                                <input type="text" name="address_city" class="form-control" value="<%= parsedAddress.city || '' %>"
                                                    placeholder="Cidade">
                                            </div>

                                            <div class="col-md-1">
                                                <label class="form-label fw-bold">UF</label>
                                                <input type="text" name="address_state" class="form-control" value="<%= parsedAddress.state || '' %>"
                                                    placeholder="SP" maxlength="2">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="card shadow-sm border-0 mb-4 h-100">
                                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center">
                                        <i class="bi bi-shield-lock text-primary fs-5 me-2"></i>
                                        <h5 class="mb-0 fw-bold">Acesso & Segurança</h5>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Função *</label>
                                            <select name="role" class="form-select">
                                                <option value="CLIENT" <%= (editUser.role === 'CLIENT') ? 'selected' : '' %>>Cliente</option>
                                                <option value="MANAGER" <%= (editUser.role === 'MANAGER') ? 'selected' : '' %>>Administrador</option>
                                                <option value="SUPPORT" <%= (editUser.role === 'SUPPORT') ? 'selected' : '' %>>Suporte</option>
                                                <option value="MASTER" <%= (editUser.role === 'MASTER') ? 'selected' : '' %>>Master</option>
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Senha <%= editing ? '' : '*' %></label>
                                            <input type="password" name="password" class="form-control"
                                                placeholder="<%= editing ? 'Deixe em branco para manter' : 'Digite a senha' %>"
                                                <%= editing ? '' : 'required' %>
                                                minlength="6">
                                            <% if (!editing) { %>
                                                <small class="text-muted d-block mt-1">Mínimo 6 caracteres</small>
                                            <% } else { %>
                                                <small class="text-warning d-block mt-1">Preencher redefinirá a senha atual.</small>
                                            <% } %>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-light border-0 p-3 text-end">
                                        <a href="/admin/users" class="btn btn-light border-secondary text-secondary me-2">
                                            Cancelar
                                        </a>
                                        <button type="submit" class="btn btn-primary px-4">
                                            <i class="bi <%= editing ? 'bi-check2-all' : 'bi-person-plus' %> me-2"></i>
                                            <%= editing ? 'Salvar' : 'Criar Conta' %>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <% if (editing) { %>
                        <div class="row g-4 mt-2 mb-4">
                            <div class="col-12">
                                <div class="card shadow-sm border-0 h-100">
                                    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center">
                                        <i class="bi bi-person-badge text-primary fs-5 me-2"></i>
                                        <h5 class="mb-0 fw-bold">Documentos Pessoais (KYC)</h5>
                                    </div>
                                    <div class="card-body p-4">
                                        <div class="row g-4 d-flex justify-content-center">
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold text-center w-100 mb-3">Documento Frente</label>
                                                <% if (editUser.documentFrontUrl) { %>
                                                    <div class="border rounded p-2 text-center bg-light shadow-sm">
                                                        <a href="<%= editUser.documentFrontUrl %>" target="_blank">
                                                            <img src="<%= editUser.documentFrontUrl %>" alt="Documento Frente" class="img-fluid rounded" style="max-height: 250px; object-fit: contain;">
                                                        </a>
                                                    </div>
                                                <% } else { %>
                                                    <div class="border rounded p-5 text-center text-muted bg-light">
                                                        <i class="bi bi-card-image fs-1 opacity-50"></i>
                                                        <p class="mb-0 mt-2">Não enviado</p>
                                                    </div>
                                                <% } %>
                                            </div>
                                            
                                            <div class="col-md-4">
                                                <label class="form-label fw-bold text-center w-100 mb-3">Documento Verso</label>
                                                <% if (editUser.documentBackUrl) { %>
                                                    <div class="border rounded p-2 text-center bg-light shadow-sm">
                                                        <a href="<%= editUser.documentBackUrl %>" target="_blank">
                                                            <img src="<%= editUser.documentBackUrl %>" alt="Documento Verso" class="img-fluid rounded" style="max-height: 250px; object-fit: contain;">
                                                        </a>
                                                    </div>
                                                <% } else { %>
                                                    <div class="border rounded p-5 text-center text-muted bg-light">
                                                        <i class="bi bi-card-image fs-1 opacity-50"></i>
                                                        <p class="mb-0 mt-2">Não enviado</p>
                                                    </div>
                                                <% } %>
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label fw-bold text-center w-100 mb-3">Selfie</label>
                                                <% if (editUser.selfieUrl) { %>
                                                    <div class="border rounded p-2 text-center bg-light shadow-sm">
                                                        <a href="<%= editUser.selfieUrl %>" target="_blank">
                                                            <img src="<%= editUser.selfieUrl %>" alt="Selfie" class="img-fluid rounded" style="max-height: 250px; object-fit: contain;">
                                                        </a>
                                                    </div>
                                                <% } else { %>
                                                    <div class="border rounded p-5 text-center text-muted bg-light">
                                                        <i class="bi bi-person-bounding-box fs-1 opacity-50"></i>
                                                        <p class="mb-0 mt-2">Não enviado</p>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    </form>
        </div>

<%- include('../../partials/footer') %>
