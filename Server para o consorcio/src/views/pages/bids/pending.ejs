<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/bids' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">Lances Pendentes</h1>
                    <p class="text-muted mb-0">Lances aguardando aprovação</p>
                </div>
                <div class="top-bar-actions">
                    <a href="/admin/bids" class="btn btn-outline-secondary shadow-sm" style="border-radius: 10px;">
                        <i class="bi bi-arrow-left me-2"></i>Voltar
                    </a>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (bids && bids.length > 0) { %>
                <!-- Summary banner -->
                <div class="premium-info-card mb-4">
                    <div class="p-4 d-flex align-items-center gap-4 flex-wrap">
                        <div>
                            <div class="info-label">Lances Aguardando</div>
                            <div class="fw-bold" style="font-size:1.8rem; color:#f59e0b;"><%= bids.length %></div>
                        </div>
                        <div style="width:1px; height:40px; background:var(--border-color);"></div>
                        <div>
                            <div class="info-label">Volume Total</div>
                            <div class="fw-bold" style="font-size:1.3rem; color:var(--success-color);">
                                R$ <%= totalAmount.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                            </div>
                        </div>
                        <div style="width:1px; height:40px; background:var(--border-color);"></div>
                        <div>
                            <div class="info-label">Maior Lance</div>
                            <div class="fw-bold" style="font-size:1.3rem; color:var(--primary-color);">
                                R$ <%= Number(bids[0]?.amount || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                            </div>
                        </div>
                        <div class="ms-auto">
                            <div class="alert alert-warning border-0 py-2 px-3 mb-0" style="border-radius:10px; background:rgba(245,158,11,0.1); color:#92400e; font-size:0.85rem;">
                                <i class="bi bi-info-circle me-1"></i>
                                Lances ordenados do maior para o menor valor
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Pending Bids Table -->
            <div class="premium-table-container">
                <div class="px-4 py-3 d-flex justify-content-between align-items-center" style="border-bottom: 1px solid var(--border-color);">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-clock-history text-warning me-2"></i>
                        Lances Pendentes (<%= bids.length %>)
                    </h5>
                </div>

                <% if (bids && bids.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-custom align-middle w-100">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Cliente</th>
                                    <th>Produto</th>
                                    <th>Tipo</th>
                                    <th>Valor</th>
                                    <th>%</th>
                                    <th>Data</th>
                                    <th class="text-end">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% bids.forEach((bid, idx) => { %>
                                    <%
                                    const creditValue = Number(bid.subscription.creditValue);
                                    const bidPct      = creditValue > 0 ? (Number(bid.amount) / creditValue * 100).toFixed(1) : '—';
                                    %>
                                    <tr>
                                        <td>
                                            <div style="width:28px; height:28px; border-radius:50%; background:<%= idx === 0 ? '#f59e0b' : idx === 1 ? '#94a3b8' : idx === 2 ? '#cd7c4a' : 'var(--bg-secondary)' %>; display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:700; color:white;">
                                                <%= idx + 1 %>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="text-white fw-bold d-flex align-items-center justify-content-center me-3 shadow-sm"
                                                    style="width:36px; height:36px; border-radius:10px; background:linear-gradient(135deg,var(--primary-color),var(--primary-dark)); font-size:0.9rem; flex-shrink:0;">
                                                    <%= bid.subscription.user.name.charAt(0).toUpperCase() %>
                                                </div>
                                                <div>
                                                    <a href="/admin/clients/<%= bid.subscription.userId %>" class="fw-semibold text-dark text-decoration-none d-block" style="font-size:0.9rem;">
                                                        <%= bid.subscription.user.name %>
                                                    </a>
                                                    <div class="text-muted small"><%= bid.subscription.user.email %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold" style="font-size:0.9rem;"><%= bid.subscription.plan.product.name %></div>
                                            <div class="text-muted small"><%= bid.subscription.plan.name %></div>
                                        </td>
                                        <td>
                                            <% if (bid.type === 'FIXED') { %>
                                                <span class="badge-premium" style="background:rgba(13,110,253,0.1); color:#0d6efd; border:1px solid rgba(13,110,253,0.2);">Fixo</span>
                                            <% } else if (bid.type === 'FREE') { %>
                                                <span class="badge-premium" style="background:rgba(6,182,212,0.1); color:#0891b2; border:1px solid rgba(6,182,212,0.2);">Livre</span>
                                            <% } else { %>
                                                <span class="badge-premium" style="background:var(--bg-secondary); color:var(--text-secondary); border:1px solid var(--border-color);"><%= bid.type %></span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <strong style="color:var(--success-color);">
                                                R$ <%= Number(bid.amount).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                            </strong>
                                        </td>
                                        <td>
                                            <span class="badge-premium" style="background:rgba(99,102,241,0.1); color:var(--primary-color); border:1px solid rgba(99,102,241,0.2); font-size:0.72rem;">
                                                <%= bidPct %>%
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i><%= new Date(bid.createdAt).toLocaleDateString('pt-BR') %></span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a href="/admin/bids/<%= bid.id %>" class="btn btn-sm btn-outline-secondary" style="border-radius:8px;" title="Detalhes">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <form action="/admin/bids/<%= bid.id %>/approve" method="POST" style="display:inline;">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-success" style="border-radius:8px;" title="Aprovar">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                </form>
                                                <form action="/admin/bids/<%= bid.id %>/reject" method="POST" style="display:inline;">
                                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                    <button type="submit" class="btn btn-sm btn-danger" style="border-radius:8px;" title="Rejeitar">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <div class="mb-4 d-inline-block p-4 rounded-circle" style="background:rgba(16,185,129,0.1);">
                            <i class="bi bi-check-circle-fill" style="font-size:3rem; color:#10b981;"></i>
                        </div>
                        <h5 class="fw-bold">Nenhum lance pendente</h5>
                        <p class="text-muted mb-0">Todos os lances foram processados.</p>
                    </div>
                <% } %>
            </div>
            <div class="mb-5"></div>
        </div>

<%- include('../../partials/footer') %>
