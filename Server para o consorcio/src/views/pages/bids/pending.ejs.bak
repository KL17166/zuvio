<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/bids' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">Lances Pendentes</h1>
                    <p class="text-muted mb-0">Lances aguardando aprovação</p>
                </div>
                <div class="top-bar-actions">
                    <a href="/admin/bids" class="btn btn-outline-secondary shadow-sm" style="border-radius: 10px;">
                        <i class="bi bi-arrow-left me-2"></i>Voltar
                    </a>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Pending Bids Table -->
            <div class="premium-table-container">
                <div class="bg-white border-0 pt-4 pb-3 px-4" style="border-bottom: 1px solid var(--border-color) !important;">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-clock-history text-warning me-2"></i>
                        Lances Pendentes (<%= bids.length %>)
                    </h5>
                </div>

                <% if (bids && bids.length > 0) { %>
                    <div class="p-0">
                        <div class="table-responsive">
                            <table class="table table-custom align-middle">
                                <thead>
                                    <tr>
                                        <th>Cliente</th>
                                        <th>Contrato</th>
                                        <th>Valor do Lance</th>
                                        <th>Data</th>
                                        <th class="text-end">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% bids.forEach(bid => { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="user-avatar text-white fw-bold d-flex align-items-center justify-content-center me-3 shadow-sm"
                                                        style="width: 36px; height: 36px; border-radius: 10px; font-size: 0.9rem;">
                                                        <%= bid.subscription.user.name.charAt(0).toUpperCase() %>
                                                    </div>
                                                    <strong class="text-dark"><%= bid.subscription.user.name %></strong>
                                                </div>
                                            </td>
                                            <td class="text-muted"><%= bid.subscription.plan.product.name %></td>
                                            <td>
                                                <strong style="color: var(--success-color);">
                                                    R$ <%= Number(bid.amount).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                                </strong>
                                            </td>
                                            <td>
                                                <span class="text-muted"><i class="bi bi-calendar3 me-1"></i><%= new Date(bid.createdAt).toLocaleDateString('pt-BR') %></span>
                                            </td>
                                            <td class="text-end">
                                                <div class="d-flex justify-content-end gap-2">
                                                    <form action="/admin/bids/<%= bid.id %>/approve" method="POST" style="display: inline;">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-success" style="border-radius: 8px;" title="Aprovar">
                                                            <i class="bi bi-check-lg"></i>
                                                        </button>
                                                    </form>
                                                    <form action="/admin/bids/<%= bid.id %>/reject" method="POST" style="display: inline;">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <button type="submit" class="btn btn-sm btn-danger" style="border-radius: 8px;" title="Rejeitar">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <div class="mb-4 d-inline-block p-4 rounded-circle" style="background: rgba(16, 185, 129, 0.1);">
                            <i class="bi bi-check-circle-fill" style="font-size: 3rem; color: #10b981;"></i>
                        </div>
                        <h5 class="text-dark fw-bold">Nenhum lance pendente</h5>
                        <p class="text-muted mb-0">Todos os lances foram processados.</p>
                    </div>
                <% } %>
            </div>
            <div class="mb-5"></div>
        </div>

<%- include('../../partials/footer') %>
