<%- include('../../partials/header') %>

    <%- include('../../partials/sidebar', { path: '/bids' }) %>

        <div class="main-content">
            <!-- Top Bar -->
            <div class="top-bar">
                <div>
                    <h1 class="page-title">Sorteio de Contemplação</h1>
                    <p class="text-muted mb-0">Realize sorteios por lance</p>
                </div>
                <div class="top-bar-actions">
                    <a href="/admin/bids/pending" class="btn btn-warning shadow-sm" style="border-radius: 10px;">
                        <i class="bi bi-clock me-2"></i>Ver Pendentes
                    </a>
                    <a href="/admin/bids" class="btn btn-outline-secondary shadow-sm" style="border-radius: 10px;">
                        <i class="bi bi-arrow-left me-2"></i>Voltar
                    </a>
                    <button class="theme-toggle" onclick="toggleTheme()">
                        <i class="bi bi-moon-stars" id="themeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Flash Messages -->
            <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0" role="alert" style="border-radius: 12px;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error_msg %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Summary banner -->
            <% const groups = Object.values(groupedBids || {}); %>
            <% if (groups.length > 0) { %>
                <div class="premium-info-card mb-4">
                    <div class="p-4 d-flex align-items-center gap-4 flex-wrap">
                        <div>
                            <div class="info-label">Grupos Elegíveis</div>
                            <div class="fw-bold" style="font-size:1.8rem; color:var(--primary-color);"><%= totalGroups %></div>
                        </div>
                        <div style="width:1px; height:40px; background:var(--border-color);"></div>
                        <div>
                            <div class="info-label">Lances Aprovados</div>
                            <div class="fw-bold" style="font-size:1.8rem; color:#10b981;"><%= totalApproved %></div>
                        </div>
                        <div class="ms-auto">
                            <div class="alert alert-info border-0 py-2 px-3 mb-0" style="border-radius:10px; background:rgba(99,102,241,0.08); color:var(--primary-color); font-size:0.85rem;">
                                <i class="bi bi-info-circle me-1"></i>
                                Os maiores lances aparecem primeiro dentro de cada grupo
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Grouped Bids by Product/Plan -->
            <% if (groups.length > 0) { %>
                <% groups.forEach((group, index) => { %>
                    <div class="premium-info-card mb-4">
                        <!-- Group Header -->
                        <div class="card-header-premium d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <h5 class="mb-0 fw-bold">
                                    <i class="bi bi-box-seam text-primary me-2"></i>
                                    <%= group.product.name %>
                                    <span class="text-muted fw-normal" style="font-size:0.9rem;">— <%= group.plan.name %></span>
                                </h5>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge-premium" style="background:rgba(16,185,129,0.1); color:#10b981; border:1px solid rgba(16,185,129,0.2);">
                                    <i class="bi bi-lightning-fill me-1"></i><%= group.bids.length %> lance(s)
                                </span>
                                <span class="badge-premium" style="background:rgba(99,102,241,0.1); color:var(--primary-color); border:1px solid rgba(99,102,241,0.2);">
                                    Volume: R$ <%= group.totalAmount.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                </span>
                            </div>
                        </div>

                        <!-- Bids Table -->
                        <div class="table-responsive">
                            <table class="table table-custom align-middle w-100">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Cliente</th>
                                        <th>Tipo</th>
                                        <th>Valor do Lance</th>
                                        <th>% do Crédito</th>
                                        <th>Data</th>
                                        <th class="text-end">Ver</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% group.bids.forEach((bid, bidIdx) => { %>
                                        <%
                                        const creditValue = Number(bid.subscription.creditValue || 0);
                                        const bidPct      = creditValue > 0 ? (Number(bid.amount) / creditValue * 100).toFixed(1) : '—';
                                        %>
                                        <tr>
                                            <td>
                                                <div <%- `style="width:28px; height:28px; border-radius:50%; background:${bidIdx === 0 ? '#f59e0b' : bidIdx === 1 ? '#94a3b8' : bidIdx === 2 ? '#cd7c4a' : 'var(--bg-secondary)'}; display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:700; color:white;"` %>>
                                                    <%= bidIdx + 1 %>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="text-white fw-bold d-flex align-items-center justify-content-center me-3 shadow-sm"
                                                        style="width:36px; height:36px; border-radius:10px; background:linear-gradient(135deg,var(--primary-color),var(--primary-dark)); font-size:0.9rem; flex-shrink:0;">
                                                        <%= bid.subscription.user.name.charAt(0).toUpperCase() %>
                                                    </div>
                                                    <div>
                                                        <strong class="text-dark d-block" style="font-size:0.9rem;"><%= bid.subscription.user.name %></strong>
                                                        <div class="text-muted small"><%= bid.subscription.user.email %></div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <% if (bid.type === 'FIXED') { %>
                                                    <span class="badge-premium" style="background:rgba(13,110,253,0.1); color:#0d6efd; border:1px solid rgba(13,110,253,0.2);">Fixo</span>
                                                <% } else if (bid.type === 'FREE') { %>
                                                    <span class="badge-premium" style="background:rgba(6,182,212,0.1); color:#0891b2; border:1px solid rgba(6,182,212,0.2);">Livre</span>
                                                <% } else { %>
                                                    <span class="badge-premium" style="background:var(--bg-secondary); color:var(--text-secondary); border:1px solid var(--border-color);"><%= bid.type %></span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <strong style="color:var(--success-color);">
                                                    R$ <%= Number(bid.amount).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                                                </strong>
                                            </td>
                                            <td>
                                                <span class="badge-premium" style="background:rgba(99,102,241,0.1); color:var(--primary-color); border:1px solid rgba(99,102,241,0.2); font-size:0.72rem;">
                                                    <%= bidPct %>%
                                                </span>
                                            </td>
                                            <td>
                                                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i><%= new Date(bid.createdAt).toLocaleDateString('pt-BR') %></span>
                                            </td>
                                            <td class="text-end">
                                                <a href="/admin/bids/<%= bid.id %>" class="btn btn-sm btn-outline-primary" style="border-radius:8px;" title="Ver detalhes">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Draw Form -->
                        <div class="p-4" style="border-top: 1px solid var(--border-color); background: var(--bg-secondary);">
                            <form action="/admin/bids/draw" method="POST" class="m-0"
                                onsubmit="return confirm('Confirmar sorteio para <%= group.product.name %> — <%= group.plan.name %>?\n\nEsta ação não pode ser desfeita.')">
                                <input type="hidden" name="_csrf"      value="<%= csrfToken %>">
                                <input type="hidden" name="productId"  value="<%= group.product.id %>">
                                <input type="hidden" name="planId"     value="<%= group.plan.id %>">
                                <div class="row align-items-end g-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-bold small text-muted text-uppercase mb-1">
                                            <i class="bi bi-trophy me-1"></i>Quantidade de Contemplados
                                        </label>
                                        <input type="number" name="numberOfWinners" class="form-control" value="1"
                                            min="1" max="<%= group.bids.length %>" style="border-radius: 8px;">
                                        <div class="form-text">Máximo: <%= group.bids.length %> lance(s)</div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="alert alert-warning border-0 py-2 px-3 mb-0" style="border-radius:10px; background:rgba(245,158,11,0.1); color:#92400e; font-size:0.8rem;">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            Os lances com maior valor serão contemplados primeiro.
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <button type="submit" class="btn btn-primary w-100" style="border-radius: 10px;">
                                            <i class="bi bi-trophy-fill me-2"></i>Contemplar
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="premium-info-card text-center py-5">
                    <div class="mb-4 d-inline-block p-4 rounded-circle" style="background:rgba(99,102,241,0.1);">
                        <i class="bi bi-inbox text-primary" style="font-size:3rem;"></i>
                    </div>
                    <h5 class="fw-bold">Nenhum lance aprovado</h5>
                    <p class="text-muted mb-3">Aprove lances pendentes para realizar sorteios.</p>
                    <a href="/admin/bids/pending" class="btn btn-warning shadow-sm" style="border-radius: 10px;">
                        <i class="bi bi-clock me-2"></i>Ver Lances Pendentes
                    </a>
                </div>
            <% } %>

            <div class="mb-5"></div>
        </div>

<%- include('../../partials/footer') %>
